PORT=4000
NODE_ENV=development

# Local Docker Postgres (host port from POSTGRES_PORT, default 5433)
DATABASE_URL=postgres://slidesmith:change-me-to-a-long-random-password@localhost:5433/slidesmith

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4001,http://127.0.0.1:4001
MAX_UPLOAD_BYTES=10485760

SESSION_TTL_DAYS=7
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
