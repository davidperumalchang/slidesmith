# =============================================================================
# SlideSmith — single env file for Docker Compose + local npm run dev
# Copy to .env and edit:  cp .env.example .env
#
# Production (Fly.io + Supabase): do NOT put secrets here for deploy.
# Set them with `fly secrets set` on the backend app (see README → Fly.io).
# =============================================================================

# Host ports
BACKEND_PORT=4000
FRONTEND_PORT=4001
# Use 5433 by default — 5432 is often already taken by another Postgres.
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# PostgreSQL (local Docker Compose only)
# ---------------------------------------------------------------------------
POSTGRES_DB=slidesmith
POSTGRES_USER=slidesmith
# REQUIRED for local — use a long random password in any shared environment.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Optional overrides (normally derived automatically for local):
# POSTGRES_HOST=localhost
# DATABASE_URL=postgres://slidesmith:PASSWORD@localhost:5433/slidesmith

# Production (Supabase): set DATABASE_URL to the Session pooler URI from
# Dashboard → Connect → Session mode (IPv4-friendly; good for Fly.io).
# Example:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SSL is auto-enabled for *.supabase.co / pooler hosts. Overrides:
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
SESSION_TTL_DAYS=7
COOKIE_SAMESITE=lax
# false for local HTTP; on Fly set COOKIE_SECURE=true (or rely on NODE_ENV=production)
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Include local Next.js (3000) and Compose frontend (4001) if you call the API host directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4001,http://127.0.0.1:4001
# Production example (Fly frontend origin):
# CORS_ALLOWED_ORIGINS=https://slidesmith-web.fly.dev
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Browser calls this path (proxied by Next.js to the backend).
NEXT_PUBLIC_API_BASE_URL=/backend-api

# Server-side rewrite target for local `npm run dev`.
# Docker Compose ignores this and uses http://backend:4000/api inside the network.
# Fly builds the frontend image with http://slidesmith-api.internal:8080/api (see frontend/fly.toml).
API_INTERNAL_URL=http://localhost:4000/api
