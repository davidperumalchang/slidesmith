# Host ports
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Backend CORS allowlist (the frontend origin(s) allowed to call the API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base URL the browser uses to reach the backend API.
# Baked into the frontend bundle at build time, so it must be reachable from
# the user's browser (not an internal docker hostname).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Max .docx upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760