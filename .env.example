# Host ports
BACKEND_PORT=4000
FRONTEND_PORT=4001
# Use 5433 by default — 5432 is often already taken by another Postgres.
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=slidesmith
POSTGRES_USER=slidesmith
# REQUIRED — use a long random password in any shared environment.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Used by the backend (docker-compose builds this automatically).
# For local (non-Docker) backend against the published host port:
# DATABASE_URL=postgres://slidesmith:PASSWORD@localhost:5433/slidesmith

# Session lifetime
SESSION_TTL_DAYS=7

# Cookie flags (same-origin Next.js proxy → lax + secure=false for local HTTP)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Backend CORS allowlist (only needed if the browser calls the API host directly)
CORS_ALLOWED_ORIGINS=http://localhost:4001,http://127.0.0.1:4001

# Max .docx upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Browser calls this path (proxied by Next.js to the backend).
NEXT_PUBLIC_API_BASE_URL=/backend-api

# Server-side rewrite target (Docker network hostname inside Compose).
API_INTERNAL_URL=http://backend:4000/api
